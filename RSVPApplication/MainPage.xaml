<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApplication.MainPage"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="RSVP Application"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="DarkBlue"
                HorizontalOptions="Center" />

            <Label
                Text="Login"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Username" />

            <Entry
                x:Name="UserNameEntry"
                Placeholder="Enter username" />

            <Label
                Text="Password" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Enter password"
                IsPassword="True" />

            <Label
                x:Name="MessageLabel"
                TextColor="Red"
                FontSize="14" />

            <Button
                Text="Login"
                BackgroundColor="DarkBlue"
                TextColor="White"
                Clicked="OnLoginClicked" />

            <Button
                Text="Continue as Guest"
                BackgroundColor="DarkBlue"
                TextColor="White"
                Clicked="OnGuestClicked" />

            <Button
                Text="Create Account"
                BackgroundColor="DarkBlue"
                TextColor="White"
                Clicked="OnCreateAccountClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>