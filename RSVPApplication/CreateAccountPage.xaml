<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApplication.CreateAccountPage">


    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="15">

            <Label
                Text="Create Account"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="DarkBlue"
                HorizontalOptions="Center" />

            <Label
                Text="First Name" />

            <Entry
                x:Name="FirstNameEntry"
                Placeholder="Enter first name" />

            <Label
                Text="Last Name" />

            <Entry
                x:Name="LastNameEntry"
                Placeholder="Enter last name" />

            <Label
                Text="Username" />

            <Entry
                x:Name="NewUserNameEntry"
                Placeholder="Enter username" />

            <Label
                Text="Password" />

            <Entry
                x:Name="NewPasswordEntry"
                Placeholder="Enter password"
                IsPassword="True" />

            <Label
                x:Name="MessageLabel"
                TextColor="Red"
                FontSize="14" />

            <Button
                Text="Create Account"
                BackgroundColor="DarkBlue"
                TextColor="White"
                Clicked="OnCreateAccountClicked" />

            <Button
                Text="Cancel"
                BackgroundColor="Gray"
                TextColor="White"
                Clicked="OnCancelClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>